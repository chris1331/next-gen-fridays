---
const pathname = Astro.url.pathname;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Alumni', href: '/alumni/' },
  { label: 'About me', href: '/about-me/' },
];

function isActive(href: string, currentPath: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand-logo" aria-label="Next-Gen Fridays Home">
      <img
        src="/images/Next-Gen-Fridays-Logo.png"
        alt="Next-Gen Fridays Logo"
        width="431"
        height="343"
        class="logo-img"
      />
    </a>

    <nav aria-label="Primary Navigation" class="desktop-nav">
      <ul class="nav-list">
        {
          navItems.map((item) => {
            const active = isActive(item.href, pathname);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={['nav-link', { 'is-active': active }]}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="header-meta">
      <span class="badge-kinetic" title="Next-Gen Fridays Historical Podcast Archive">
        <span class="archive-dot" aria-hidden="true"></span>
        Podcast Archive
      </span>

      <button
        type="button"
        class="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label="Toggle navigation menu"
      >
        <svg class="icon-menu" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav-drawer"
    aria-label="Mobile Navigation"
    class="mobile-nav"
    inert
  >
    <ul class="mobile-nav-list">
      {
        navItems.map((item) => {
          const active = isActive(item.href, pathname);
          return (
            <li>
              <a
                href={item.href}
                class:list={['mobile-nav-link', { 'is-active': active }]}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<script>
  const toggleBtn = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
  const mobileDrawer = document.getElementById('mobile-nav-drawer');

  if (toggleBtn && mobileDrawer) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      const nextState = !isExpanded;
      toggleBtn.setAttribute('aria-expanded', String(nextState));
      if (nextState) {
        mobileDrawer.removeAttribute('inert');
        mobileDrawer.classList.add('is-open');
      } else {
        mobileDrawer.setAttribute('inert', '');
        mobileDrawer.classList.remove('is-open');
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgba(12, 12, 12, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 5rem;
    gap: 1.5rem;
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo-img {
    width: 132px;
    height: auto;
    filter: brightness(200%) contrast(100%) saturate(0%);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .brand-logo:hover .logo-img {
    transform: scale(1.02);
    opacity: 0.9;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
    transition: color 0.2s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-neon-crimson), var(--color-kinetic-vermilion));
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.25s ease;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--color-pure-white);
  }

  .nav-link.is-active::after,
  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .archive-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background-color: var(--color-neon-crimson);
    box-shadow: 0 0 8px var(--color-neon-crimson);
  }

  .mobile-menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--color-elevated-1);
    border: 1px solid var(--color-charcoal-elevated);
    border-radius: var(--radius-default);
    color: var(--color-pure-white);
    cursor: pointer;
  }

  .mobile-menu-toggle .icon-close {
    display: none;
  }

  .mobile-menu-toggle[aria-expanded='true'] .icon-menu {
    display: none;
  }

  .mobile-menu-toggle[aria-expanded='true'] .icon-close {
    display: block;
  }

  .mobile-nav {
    display: none;
    background-color: rgba(12, 12, 12, 0.96);
    border-bottom: 1px solid var(--color-charcoal-elevated);
    padding: 0 1.25rem;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.25s ease, padding 0.25s ease;
  }

  .mobile-nav.is-open {
    padding: 1rem 1.25rem 1.5rem;
    max-height: 16rem;
    opacity: 1;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-default);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
    border: 1px solid transparent;
  }

  .mobile-nav-link.is-active,
  .mobile-nav-link:hover {
    color: var(--color-pure-white);
    background-color: var(--color-elevated-1);
    border-color: rgba(236, 0, 68, 0.4);
  }

  @media (max-width: 767px) {
    .desktop-nav {
      display: none;
    }

    .mobile-menu-toggle {
      display: inline-flex;
    }

    .mobile-nav {
      display: block;
    }
  }
</style>
