---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import AlumniCard from '../components/AlumniCard.astro';

interface Props {
  entry: CollectionEntry<'alumni'>;
  pastEpisodes: CollectionEntry<'alumni'>[];
}

const { entry, pastEpisodes } = Astro.props;
const {
  name,
  coverImage,
  coverImageAlt,
  bio,
  bioHtml,
  spotifyEmbeds,
  socials,
  missionStatement,
  favoriteQuote,
  weirdFact,
  lifeMovieTitle,
} = entry.data;

const hasQA = Boolean(missionStatement || favoriteQuote || weirdFact || lifeMovieTitle);

const qaItems = [
  { label: 'Your Mission Statement:', value: missionStatement },
  { label: 'Your favourite quote:', value: favoriteQuote },
  { label: 'A weird fact about you:', value: weirdFact },
  { label: 'If your life was made into a movie. What would the title be?', value: lifeMovieTitle },
].filter((item) => Boolean(item.value));

function getSocialIcon(label: string) {
  const normalized = label.toLowerCase();
  if (normalized.includes('instagram')) return 'instagram';
  if (normalized.includes('linkedin')) return 'linkedin';
  if (normalized.includes('twitter') || normalized.includes('x')) return 'twitter';
  if (normalized.includes('youtube')) return 'youtube';
  return 'globe';
}
---

<BaseLayout
  title={`${name} – Next-Gen Fridays`}
  description={bio || `Listen to ${name} on the Next-Gen Fridays podcast archive.`}
  ogImage={coverImage}
  ogType="article"
>
  <article class="alumni-single">
    <div class="container">
      <div class="grid-12 alumni-split">
        <!-- Left Column: Sticky Guest Profile & Socials -->
        <aside class="alumni-profile-col">
          <div class="alumni-profile-sticky">
            <a href="/alumni/" class="back-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
              <span>back to all</span>
            </a>

            <h1 class="text-display guest-name">{name}</h1>

            <div class="bio-section">
              <h2 class="text-headline-sm bio-heading">Bio:</h2>
              {
                bioHtml ? (
                  <div class="text-body-lg bio-copy" set:html={bioHtml} />
                ) : (
                  <p class="text-body-lg bio-copy">{bio}</p>
                )
              }
            </div>

            {
              socials.length > 0 && (
                <div class="socials-section" aria-label={`${name} social links`}>
                  <ul class="socials-list">
                    {socials.map((social) => {
                      const iconType = getSocialIcon(social.label);
                      return (
                        <li>
                          <a
                            href={social.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="social-chip"
                          >
                            {iconType === 'globe' && (
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" />
                                <line x1="2" y1="12" x2="22" y2="12" />
                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                              </svg>
                            )}
                            {iconType === 'instagram' && (
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                              </svg>
                            )}
                            {iconType === 'linkedin' && (
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                                <rect x="2" y="9" width="4" height="12" />
                                <circle cx="4" cy="4" r="2" />
                              </svg>
                            )}
                            {iconType === 'twitter' && (
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z" />
                              </svg>
                            )}
                            {iconType === 'youtube' && (
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z" />
                                <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" />
                              </svg>
                            )}
                            <span>{social.label}</span>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              )
            }
          </div>
        </aside>

        <!-- Right Column: Magazine Cover, Spotify Players & Q&A -->
        <div class="alumni-media-col">
          <div class="cover-showcase surface-card">
            <img
              src={coverImage}
              alt={coverImageAlt}
              width="1080"
              height="1080"
              fetchpriority="high"
              class="single-cover-img"
            />
          </div>

          {
            spotifyEmbeds.length > 0 && (
              <section class="episodes-player-section" aria-label="Podcast Episodes">
                {spotifyEmbeds.map((embedUrl, index) => (
                  <div class="spotify-embed-card surface-card">
                    <iframe
                      src={embedUrl}
                      width="100%"
                      height="232"
                      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                      loading="lazy"
                      title={`${name} Next-Gen Fridays Spotify Episode ${index + 1}`}
                      class="spotify-iframe"
                    />
                  </div>
                ))}
              </section>
            )
          }

          {
            hasQA && (
              <section class="qa-section surface-card" aria-label="Guest Rapid-Fire Q&A">
                <div class="qa-list">
                  {qaItems.map((item) => (
                    <div class="qa-item">
                      <h3 class="text-title-md qa-question">{item.label}</h3>
                      <p class="text-body-lg qa-answer">{item.value}</p>
                    </div>
                  ))}
                </div>
              </section>
            )
          }
        </div>
      </div>

      <!-- Bottom Section: Past Episodes -->
      {
        pastEpisodes.length > 0 && (
          <section class="past-episodes-section" aria-labelledby="past-episodes-heading">
            <div class="past-episodes-header">
              <h2 id="past-episodes-heading" class="text-headline-md">Past Episodes:</h2>
              <a href="/alumni/" class="btn-ghost">View All Alumni</a>
            </div>
            <div class="past-episodes-grid">
              {pastEpisodes.map((ep) => (
                <AlumniCard
                  name={ep.data.name}
                  slug={ep.data.slug}
                  coverImage={ep.data.coverImage}
                  coverImageAlt={ep.data.coverImageAlt}
                  pubDate={ep.data.pubDate}
                />
              ))}
            </div>
          </section>
        )
      }

      <!-- Follow Chris Now -->
      <section class="follow-band surface-card" aria-labelledby="follow-heading">
        <h2 id="follow-heading" class="text-headline-md follow-title">Liked this story?</h2>
        <p class="text-body-lg follow-text">I’m still relentlessly curious, just in new places.</p>
        <ul class="follow-list">
          <li>
            <a href="https://chrislatham.ca" target="_blank" rel="noopener noreferrer" class="follow-link">chrislatham.ca</a>
            <span class="follow-desc">Marketing, AI and the rabbit holes in between</span>
          </li>
          <li>
            <a href="https://thelatham.net" target="_blank" rel="noopener noreferrer" class="follow-link">thelatham.net</a>
            <span class="follow-desc">Show up on camera. Buy back the human.</span>
          </li>
        </ul>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .alumni-single {
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  .alumni-split {
    align-items: start;
  }

  .alumni-profile-col {
    grid-column: span 5;
    position: sticky;
    top: 6.5rem;
  }

  .alumni-media-col {
    grid-column: span 7;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  @media (max-width: 1023px) {
    .alumni-profile-col {
      grid-column: span 8;
      position: static;
    }

    .alumni-media-col {
      grid-column: span 8;
    }
  }

  @media (max-width: 767px) {
    .alumni-profile-col,
    .alumni-media-col {
      grid-column: span 4;
    }
  }

  .alumni-profile-sticky {
    background-color: var(--color-card-surface);
    border: 1px solid var(--color-charcoal-elevated);
    border-radius: var(--radius-default);
    padding: 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    color: var(--color-on-surface-muted);
    margin-bottom: 1.25rem;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-neon-crimson);
    transform: translateX(-3px);
  }

  .guest-name {
    text-decoration: underline;
    text-decoration-color: var(--color-neon-crimson);
    text-underline-offset: 8px;
    text-decoration-thickness: 4px;
    margin-bottom: 2rem;
  }

  .bio-section {
    margin-bottom: 2rem;
  }

  .bio-heading {
    margin-bottom: 0.75rem;
    color: var(--color-pure-white);
  }

  .bio-copy {
    margin: 0;
    color: var(--color-on-surface-muted);
  }

  .bio-copy :global(p) {
    margin: 0.75rem 0 0;
  }

  .bio-copy :global(a) {
    color: var(--color-neon-crimson);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .socials-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .social-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.125rem;
    background-color: var(--color-elevated-2);
    border: 1px solid var(--color-charcoal-elevated);
    border-radius: var(--radius-default);
    color: var(--color-pure-white);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .social-chip svg {
    color: var(--color-neon-crimson);
    transition: color 0.2s ease;
  }

  .social-chip:hover {
    background-color: var(--color-neon-crimson);
    border-color: var(--color-neon-crimson);
    color: var(--color-pure-white);
    transform: translateY(-2px);
    box-shadow: 0 0 20px rgba(236, 0, 68, 0.4);
  }

  .social-chip:hover svg {
    color: var(--color-pure-white);
  }

  .cover-showcase {
    padding: 1rem;
    background-color: var(--color-card-surface);
  }

  .single-cover-img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }

  .episodes-player-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .spotify-embed-card {
    padding: 1rem;
  }

  .spotify-iframe {
    display: block;
    width: 100%;
    border: 0;
    border-radius: var(--radius-sm);
  }

  .qa-section {
    padding: 2rem;
  }

  .qa-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .qa-item {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(52, 52, 52, 0.7);
  }

  .qa-item:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .qa-question {
    color: var(--color-neon-crimson);
    margin-bottom: 0.375rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 13px;
    font-weight: 700;
  }

  .qa-answer {
    margin: 0;
    color: var(--color-pure-white);
    font-size: 18px;
    font-weight: 600;
    line-height: 28px;
  }

  .past-episodes-section {
    margin-top: var(--space-3xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-charcoal-elevated);
  }

  .past-episodes-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: var(--space-lg);
  }

  .past-episodes-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gutter);
  }

  @media (max-width: 1023px) {
    .past-episodes-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .past-episodes-grid {
      grid-template-columns: 1fr;
    }
  }

  .follow-band {
    margin-top: var(--space-3xl);
    padding: 3rem 2.5rem;
    text-align: center;
    background: linear-gradient(180deg, var(--color-elevated-1) 0%, var(--color-card-surface) 100%);
    box-shadow: 0 0 48px rgba(236, 0, 68, 0.08);
  }

  .follow-title {
    margin-bottom: 0.5rem;
  }

  .follow-text {
    margin: 0 auto 2rem;
    color: var(--color-on-surface-muted);
  }

  .follow-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--grid-gutter);
  }

  .follow-list li {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1.5rem;
    border: 1px solid var(--color-charcoal-elevated);
    border-radius: var(--radius-default);
    background-color: var(--color-surface-low);
  }

  .follow-link {
    font-size: 20px;
    font-weight: 700;
    color: var(--color-neon-crimson);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .follow-link:hover {
    color: var(--color-kinetic-vermilion);
  }

  .follow-desc {
    font-size: 15px;
    color: var(--color-on-surface-muted);
  }

  @media (max-width: 767px) {
    .follow-band {
      padding: 2rem 1.5rem;
    }

    .follow-list {
      grid-template-columns: 1fr;
    }
  }
</style>
